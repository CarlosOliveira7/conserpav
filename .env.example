# Copie este arquivo para ".env" (somente se precisar apontar para outra API).
# Em desenvolvimento NÃO é necessário: o Vite encaminha /api para http://localhost:3001.
# Em produção (Vercel), defina com a URL pública da API, terminando em /api:
# VITE_API_URL=https://sua-api.onrender.com/api
VITE_API_URL=
