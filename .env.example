# Front-end: use /api em desenvolvimento; em produção, informe a URL pública da API.
# O valor pode terminar ou não em /api; o build normaliza automaticamente.
VITE_API_URL=/api

# API (copie para server/.env ao executar a API localmente).
PORT=3001
# URL local de exemplo, sem credenciais reais. Substitua pela conexão do seu PostgreSQL.
DATABASE_URL=
DATABASE_SSL=false
# Gere uma chave aleatória com pelo menos 32 caracteres antes de iniciar a API.
JWT_SECRET=
JWT_EXPIRES_IN=8h
# Opcional: origens cruzadas autorizadas, separadas por vírgula e sem barra final.
# Deixe vazio para não habilitar CORS para outras origens.
CORS_ORIGIN=
# Padrões: development = false/lax; production = true/lax.
COOKIE_SECURE=
COOKIE_SAMESITE=
# Opcional; deixe vazio para não definir Domain.
COOKIE_DOMAIN=
APP_URL=http://localhost:5173

# SMTP opcional. Sem configuração, o link de recuperação é registrado nos logs locais.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
