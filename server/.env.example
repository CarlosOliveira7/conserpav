# Copie para "server/.env" e ajuste antes de iniciar a API.
PORT=3001
# String de conexão do PostgreSQL; use a URL interna do Railway no deploy.
DATABASE_URL=
# false na rede privada do Railway; true para provedores que exigem SSL.
DATABASE_SSL=false
# Segredo para assinar os tokens JWT — mínimo 32 caracteres; gere um valor aleatório:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
# Origens permitidas no CORS (separe por vírgula, sem barra final).
CORS_ORIGIN=http://localhost:5173
# Produção usa Secure + SameSite=None por padrão; estas opções podem sobrescrever isso.
COOKIE_SECURE=
COOKIE_SAMESITE=
# Opcional. Não defina para subdomínios Railway em domínios públicos compartilhados.
COOKIE_DOMAIN=
# URL pública do front-end, usada nos links de recuperação de senha.
APP_URL=http://localhost:5173

# SMTP opcional. Sem SMTP, o link de recuperação é registrado nos logs locais.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
