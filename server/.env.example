# Copie para "server/.env" e ajuste.
PORT=3001
# String de conexão do PostgreSQL
DATABASE_URL=postgresql://conserpav:conserpav@localhost:5432/conserpav
# Use "true" em provedores que exigem SSL (Render, Neon, Railway, etc.)
DATABASE_SSL=false
# Segredo para assinar os tokens JWT — mínimo 32 caracteres (gere um valor longo e aleatório):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-segredo-por-uma-chave-forte-com-mais-de-32-caracteres
JWT_EXPIRES_IN=8h
# Origens permitidas no CORS (separe por vírgula). Ex.: https://seu-app.vercel.app
CORS_ORIGIN=http://localhost:5173
# URL pública do front-end (usada no link do e-mail de recuperação de senha)
APP_URL=http://localhost:5173

# SMTP (opcional). Sem SMTP, o link de recuperação é impresso no console da API.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Conserpav <no-reply@exemplo.com>"
